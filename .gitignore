# =============================================
# IBMEC Assessment · .gitignore
# =============================================

# Credenciais e secrets — NUNCA commitar
.env
.env.local
.env.*.local
*.key
*.pem
config.local.*

# Supabase local
.supabase/
supabase/.temp/
supabase/.branches/

# Node (caso adicionemos npm tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
# Exceção escopada: o lockfile dos testes de comportamento da carga é versionado
# (reprodutibilidade do npm ci). É a única dependência da casa — e é de DEV.
!screener/loader/behavioral/package-lock.json

# Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Logs
logs/
*.log

# OS
.DS_Store
desktop.ini

# Backups
*.bak
*.backup
*-backup.html
*-backup.*

# Outputs locais (dev)
/tmp/
.scratch/

# Estado local do CLI do Netlify — traz caminho absoluto da maquina
.netlify/

# build do site dedicado do Diagnostico Boomit (montado a partir de src/ + frontend/)
diagnostico/public/
